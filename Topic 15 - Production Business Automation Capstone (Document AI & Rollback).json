        "jsCode": "return {\\n  json: {\\n    status: \"REJECTED_INVALID_DOCUMENT\",\\n    reason: \"Missing required candidate identity, email, or role specifications in PDF contract\",\\n    rejectedAt: new Date().toISOString()\\n  }\\n};"
      },

        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { email: $('Transform_ParseContractText').item.json.employee.email, role: $('Transform_ParseContractText').item.json.employee.role, clearance: $('Transform_ParseContractText').item.json.employee.securityClearance } }}",
        "options": {}

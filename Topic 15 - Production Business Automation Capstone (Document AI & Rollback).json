    {
      "parameters": {
        "jsCode": "const emp = $('Transform_ParseContractText').item.json.employee;\\nreturn {\\n  json: {\\n    pipelineStatus: \"ONBOARDING_COMPLETED_SUCCESSFULLY\",\\n    candidateName: emp.name,\\n    corporateEmail: emp.email,\\n    department: emp.department,\\n    role: emp.role,\\n    baseSalaryUSD: emp.salary,\\n    securityClearance: emp.securityClearance,\\n    systemsProvisioned: [\\n      \"HRIS Core Database (Employee Record Staged)\",\\n      \"Okta Identity Provider (MFA Enrolled & Provisioned)\",\\n      \"IT Jira Asset Management (Hardware Dispatched)\",\\n      \"Slack Internal Announcements (#announcements Welcome Broadcast)\"\\n    ],\\n    completedAt: new Date().toISOString()\\n  }\\n};"
      },

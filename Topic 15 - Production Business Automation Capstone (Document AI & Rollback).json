    {
      "parameters": {
        "jsCode": "const error = $input.first()?.json || {};\\nconst failedNode = error.execution?.error?.node?.name || \"HTTP_CreateAssetTicket\";\\n\\n// Compensating rollback actions across microservices\\nconst rollbackLog = [];\\nif ([\"HTTP_ProvisionIdentityAccount\", \"HTTP_CreateAssetTicket\", \"HTTP_PostSlackWelcome\"].includes(failedNode)) {\\n  rollbackLog.push(\"ACTION: Soft-delete newly staged HRIS record (ROLLBACK)\");\\n}\\nif ([\"HTTP_CreateAssetTicket\", \"HTTP_PostSlackWelcome\"].includes(failedNode)) {\\n  rollbackLog.push(\"ACTION: Revoke and deprovision newly created Okta account (ROLLBACK)\");\\n}\\nif (failedNode === \"HTTP_PostSlackWelcome\") {\\n  rollbackLog.push(\"ACTION: Cancel dispatched hardware requisition tickets in Jira (ROLLBACK)\");\\n}\\n\\nreturn [{\\n  json: {\\n    sagaStatus: \"COMPENSATING_TRANSACTIONS_EXECUTED\",\\n    failedNode: failedNode,\\n    rollbackActions: rollbackLog,\\n    pipelineIntegrityRestored: true,\\n    rolledBackAt: new Date().toISOString()\\n  }\\n}];"
      },

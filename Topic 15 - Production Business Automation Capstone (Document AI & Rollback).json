    {
      "parameters": {
        "jsCode": "const emp = $('Transform_ParseContractText').item.json.employee;\nconst isEngineer = emp.department === 'Engineering';\nconst bundle = isEngineer ? [\n  { assetType: 'MacBook Pro M3 Max 64GB', category: 'Laptop', priority: 'URGENT' },\n  { assetType: '4K Dual Display Monitors', category: 'Peripherals', priority: 'STANDARD' },\n  { assetType: 'YubiKey 5C FIPS Security Key', category: 'Security', priority: 'CRITICAL' }\n] : [\n  { assetType: 'ThinkPad T14s 32GB', category: 'Laptop', priority: 'STANDARD' }\n];\n\n// Unroll bundle into separate n8n items for the loop\nreturn bundle.map(item => ({\n  json: {\n    ...item,\n    employeeName: emp.name,\n    recipient: emp.email,\n    department: emp.department\n  }\n}));"
      },
